{
  "name": "pm2-notify",
  "version": "1.0.0",
  "description": "Batched email notifier for PM2 error logs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "lint": "oxlint",
    "typecheck": "tsc",
    "prestart": "npm run lint && npm run typecheck",
    "start": "node src/app.ts",
    "mail:preview": "node src/mail.preview.ts",
    "pm2:start": "NODE_ENV=production pm2 start src/app.ts --interpreter node --name pm2-notify --no-pmx --log-date-format 'YYYY-MM-DD HH:mm:ss'",
    "pm2:delete": "pm2 delete pm2-notify"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "mjml": "^5.4.1",
    "nodemailer": "^10.0.12",
    "pm2": "^7.0.4"
  },
  "devDependencies": {
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.19.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "license": "MIT"
}
